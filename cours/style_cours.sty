% ============================================================
% style_cours.sty
% Style visuel commun du cours FDTD/EME/FEM & interaction fonderie.
% Ce fichier est la SEULE source de vérité pour la palette, les
% polices, les boîtes pédagogiques (Objectifs/Prérequis/Rappel/
% Livrable/Ressources) et la mise en page du code. Toute nouvelle
% unité doit réutiliser ces environnements plutôt que redéfinir
% son propre style, afin de garantir l'homogénéité visuelle sur
% l'ensemble du document, y compris entre sessions de génération.
% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style_cours}[2026/07/19 Style du cours FDTD/EME/FEM]

% ---------- Langue et polices (XeLaTeX) ----------
\RequirePackage{fontspec}
\RequirePackage{polyglossia}
\setdefaultlanguage{french}
\setmainfont{Latin Modern Roman}
\setsansfont{Latin Modern Sans}
\setmonofont{Latin Modern Mono}[Scale=0.9]

% ---------- Mise en page ----------
\RequirePackage[a4paper,margin=2.5cm,headheight=15pt]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{graphicx}
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{siunitx}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage[table]{xcolor}
\RequirePackage[most]{tcolorbox}
\RequirePackage{hyperref}
\RequirePackage{cleveref}
\RequirePackage{enumitem}
\RequirePackage{listings}

% ---------- Palette (identique pour tout le document) ----------
\definecolor{coursbleu}{HTML}{1B3A5C}     % bleu profond : titres, en-têtes
\definecolor{coursbleuclair}{HTML}{4C7FB3} % bleu clair : filets, accents
\definecolor{coursvert}{HTML}{2E7D5B}     % vert : boîte Objectifs
\definecolor{coursorange}{HTML}{C1662F}   % orange : boîte Rappel/mise à niveau
\definecolor{coursviolet}{HTML}{6A4C93}   % violet : boîte Livrable
\definecolor{coursgris}{HTML}{5A5A5A}     % gris : boîte Ressources / ligne de code
\definecolor{coursfond}{HTML}{F5F7FA}     % fond clair des boîtes et du code

% ---------- En-têtes / pieds de page ----------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\small\textcolor{coursbleu}{Simulation photonique : FDTD/EME/FEM et interaction fonderie}}
\fancyhead[R]{\small\textcolor{coursbleu}{\leftmark}}
\fancyfoot[C]{\small\thepage}

\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\small\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% ---------- Titres de chapitre/section ----------
\titleformat{\chapter}[display]
  {\normalfont\Huge\bfseries\color{coursbleu}}
  {\chaptertitlename\ \thechapter}{20pt}{\Huge}
\titleformat{\section}
  {\normalfont\Large\bfseries\color{coursbleu}}
  {\thesection}{1em}{}
\titleformat{\subsection}
  {\normalfont\large\bfseries\color{coursbleuclair}}
  {\thesubsection}{1em}{}

% ---------- Environnement de code (listings) ----------
% Environnement générique ; le langage est fixé par unité via
% l'option [language=...] (Python, [Lumerical]Verilog en secours,
% ou "text" pour le Lumerical Script Language non reconnu nativement).
\lstdefinestyle{coursstyle}{
  backgroundcolor=\color{coursfond},
  basicstyle=\ttfamily\footnotesize,
  keywordstyle=\color{coursbleu}\bfseries,
  commentstyle=\color{coursgris}\itshape,
  stringstyle=\color{coursvert},
  numbers=left,
  numberstyle=\tiny\color{coursgris},
  numbersep=8pt,
  frame=single,
  rulecolor=\color{coursbleuclair},
  breaklines=true,
  breakatwhitespace=false,
  showstringspaces=false,
  tabsize=2,
  xleftmargin=1em,
  xrightmargin=1em,
  framexleftmargin=0.8em,
}
\lstset{style=coursstyle}

% Alias sémantique : \begin{coursecode}[language=Python]{Titre}
\lstnewenvironment{coursecode}[2][]
  {\lstset{#1}\refstepcounter{coursecodecounter}}
  {}
\newcounter{coursecodecounter}[chapter]

% ---------- Boîtes pédagogiques ----------
% Style de base partagé par toutes les boîtes.
\tcbset{
  base/.style={
    enhanced,
    breakable,
    boxrule=0.6pt,
    left=6pt,right=6pt,top=4pt,bottom=4pt,
    arc=2pt,
    fonttitle=\bfseries,
    coltext=black,
  }
}

% Objectifs pédagogiques (vert)
\newtcolorbox{objectifs}[1][Objectifs pédagogiques]{
  base,
  colback=coursvert!6,
  colframe=coursvert,
  coltitle=white,
  colbacktitle=coursvert,
  title=#1,
}

% Prérequis (bleu clair)
\newtcolorbox{prerequis}[1][Prérequis]{
  base,
  colback=coursbleuclair!6,
  colframe=coursbleuclair,
  coltitle=white,
  colbacktitle=coursbleuclair,
  title=#1,
}

% Rappel / mise à niveau — pont thèse -> industrie (orange)
\newtcolorbox{rappel}[1][Rappel \& mise à niveau]{
  base,
  colback=coursorange!8,
  colframe=coursorange,
  coltitle=white,
  colbacktitle=coursorange,
  title=#1,
}

% Lien avec le flot fonderie (gris-bleu, icône conceptuelle "usine")
\newtcolorbox{flotfonderie}[1][Lien avec le flot fonderie]{
  base,
  colback=coursbleu!6,
  colframe=coursbleu,
  coltitle=white,
  colbacktitle=coursbleu,
  title=#1,
}

% Livrable de fin d'unité (violet)
\newtcolorbox{livrable}[1][Livrable de fin d'unité]{
  base,
  colback=coursviolet!6,
  colframe=coursviolet,
  coltitle=white,
  colbacktitle=coursviolet,
  title=#1,
}

% Ressources complémentaires (gris)
\newtcolorbox{ressources}[1][Ressources complémentaires]{
  base,
  colback=coursgris!6,
  colframe=coursgris,
  coltitle=white,
  colbacktitle=coursgris,
  title=#1,
}

% Exercices (numérotés, bleu profond, non colorés en fond pour ne pas
% surcharger visuellement une section qui peut contenir plusieurs boîtes)
\newtcolorbox{exercice}[2][]{
  base,
  colback=white,
  colframe=coursbleu!70,
  coltitle=white,
  colbacktitle=coursbleu!70,
  title=Exercice #2#1,
}

% Exercice diagnostic (type FAE / support technique client)
\newtcolorbox{diagnostic}[1][Exercice diagnostic]{
  base,
  colback=coursorange!4,
  colframe=coursorange!80!black,
  coltitle=white,
  colbacktitle=coursorange!80!black,
  title=#1,
}

\endinput
